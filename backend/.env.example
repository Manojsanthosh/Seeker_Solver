# SolveMate Backend Configuration

PROJECT_NAME="SolveMate Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-key-in-production"
REFRESH_SECRET_KEY="replace-with-another-secure-random-32-byte-hex-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Default SQLite async for instant local development:
DATABASE_URL="sqlite+aiosqlite:///./solvemate.db"

# Or PostgreSQL async for production:
# DATABASE_URL="postgresql+asyncpg://postgres:yourpassword@localhost:5432/solvemate"

# Financial Rules (All values in ₹ INR)
PLATFORM_FEE_PERCENTAGE=0.10
GST_PERCENTAGE=0.18

# CORS Allowed Origins (Comma separated in env or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
